/* tsconfig.json */

{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*", "src/pages/.well-known/**/*.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			"@config/*": ["./config/*"],
			"@assets/*": ["./src/assets/*"],
			"@components/*": ["./src/components/*"],
			"@utils/*": ["./src/utils/*"]
		}
	}
}
