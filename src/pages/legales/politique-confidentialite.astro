---
import Prose from "@components/layout/Prose.astro";
import { pages } from "@config/content/pages";
import { siteConfig } from "@config/content/site";
import { layoutProps } from "@utils/page-meta";
import Layout from "../../layouts/Layout.astro";

const meta = pages.politiqueConfidentialite;
const org = siteConfig.organization;
const { contact } = org;
---

<Layout {...layoutProps(meta)}>
	<Prose>
		<h1 class="t-h2">Politique de confidentialité</h1>

		<section class="stack">
			<h2 class="t-h4">Responsable du traitement</h2>
			<p class="t-body">
				{org.legalName}, {org.address.street}, {org.address.postalCode}
				{org.address.locality}. Contact :
				<a href={`mailto:${contact.email}`}>{contact.email}</a>.
			</p>
		</section>

		<section class="stack">
			<h2 class="t-h4">Données collectées</h2>
			<p class="t-body">
				Ce site peut collecter des données techniques (adresse IP, navigateur,
				pages consultées) via les journaux du serveur et des cookies strictement
				nécessaires au fonctionnement. Aucune donnée n'est vendue à des tiers.
			</p>
		</section>

		<section class="stack">
			<h2 class="t-h4">Cookies</h2>
			<p class="t-body">
				Des cookies peuvent être déposés pour mémoriser vos préférences
				d'affichage (thème clair/sombre). Vous pouvez les supprimer via les
				paramètres de votre navigateur.
			</p>
		</section>

		<section class="stack">
			<h2 class="t-h4">Durée de conservation</h2>
			<p class="t-body">
				Les journaux techniques sont conservés le temps nécessaire à la sécurité
				et à la maintenance du site, puis supprimés ou anonymisés.
			</p>
		</section>

		<section class="stack">
			<h2 class="t-h4">Vos droits (RGPD)</h2>
			<p class="t-body">
				Vous disposez d'un droit d'accès, de rectification, d'effacement, de
				limitation et d'opposition au traitement de vos données. Pour exercer
				ces droits, contactez-nous à
				<a href={`mailto:${contact.email}`}>{contact.email}</a>.
			</p>
		</section>

		<section class="stack">
			<h2 class="t-h4">Hébergement et sous-traitants</h2>
			<p class="t-body">
				Le site est hébergé par
				<a href={contact.hosting.url} rel="noopener noreferrer"
					>{contact.hosting.name}</a
				>. Consultez leur
				<a href={contact.hosting.privacyPolicyUrl} rel="noopener noreferrer"
					>politique de confidentialité</a
				>
				pour en savoir plus sur le traitement des données côté hébergeur.
			</p>
		</section>
	</Prose>
</Layout>
