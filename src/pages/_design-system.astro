---
import { pages } from "@config/content/pages";
import { ColorData, paletteToCSSVars } from "@config/design/colors";
import type { ColorToken } from "@config/types";
import { layoutProps } from "@utils/page-meta";
import Layout from "../layouts/Layout.astro";

const tokenGroups: { label: string; tokens: ColorToken[] }[] = [
	{
		label: "Base",
		tokens: [
			"primary",
			"secondary",
			"muted",
			"faint",
			"accent",
			"highlight",
			"disabled",
		],
	},
	{ label: "Surfaces", tokens: ["bgAlt", "bgWarm", "bgCard"] },
	{
		label: "Alt cards",
		tokens: ["altCard_1", "altCard_2", "altCard_3", "altCard_4"],
	},
	{ label: "Info", tokens: ["fgInfo", "bgInfo", "bdInfo"] },
	{ label: "Warning", tokens: ["fgWarning", "bgWarning", "bdWarning"] },
	{ label: "Alert", tokens: ["fgAlert", "bgAlert", "bdAlert"] },
	{ label: "Success", tokens: ["fgSuccess", "bgSuccess", "bdSuccess"] },
];

const darkPaletteCSS = paletteToCSSVars(ColorData.colors.dark);
const colDarkCSS = `.col--dark {\n${darkPaletteCSS}\n\tbackground: var(--color-secondary);\n\tcolor: var(--color-primary);\n}`;

const altCards = [
	{ token: "altCard_1" as const, label: "Alt 1" },
	{ token: "altCard_2" as const, label: "Alt 2" },
	{ token: "altCard_3" as const, label: "Alt 3" },
	{ token: "altCard_4" as const, label: "Alt 4" },
];

const alerts = [
	{ kind: "Info", fg: "fgInfo", bg: "bgInfo", bd: "bdInfo" },
	{ kind: "Warning", fg: "fgWarning", bg: "bgWarning", bd: "bdWarning" },
	{ kind: "Alert", fg: "fgAlert", bg: "bgAlert", bd: "bdAlert" },
	{ kind: "Success", fg: "fgSuccess", bg: "bgSuccess", bd: "bdSuccess" },
] as const;
---

<Layout {...layoutProps(pages.home)}>
	<div class="ds" aria-label="Design system mockup">
		<section class="col">
			<header class="ds-header">
				<p class="meta">Design system · Light Dark theme</p>
				<h1 class="t-h1">
					Dekamus<br><span class="a-accent">association</span>
				</h1>
				<p class="t-lead">
					Color tokens, typography, and components driven by
					<code class="t-mono-sm">config/colors.ts</code>
					and
					<code class="t-mono-sm">ColorsCSSVars.astro</code>.
				</p>
				<span class="ds-chip">highlight token</span>
			</header>

			<section class="ds-section" aria-labelledby="light-colors">
				<h2 id="light-colors" class="ds-section-title">Colors</h2>
				{tokenGroups.map((group) => (
						<div class="ds-group">
							<h3 class="ds-group-label">{group.label}</h3>
							<div class="ds-swatches">
								{group.tokens.map((token) => (
									<div class="ds-swatch">
										<div
											class="ds-swatch-color"
											style={`background:var(--color-${token})`}
											title={token}
										/>
										<span class="ds-swatch-name">{token}</span>
									</div>
								))}
							</div>
						</div>
					))}
			</section>

			<section class="ds-section" aria-labelledby="light-type">
				<h2 id="light-type" class="ds-section-title">Typography</h2>

				<div class="block">
					<span class="meta">h1 · Syne 800</span>
					<p class="t-h1">
						Dekamus<br><span class="a-accent">association</span>
					</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>clamp(56–80px)</span>
						<span class="spec-item"><span>leading</span>1.00</span>
						<span class="spec-item"><span>tracking</span>−0.03em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">h2 · Syne 700</span>
					<p class="t-h2">The weight of<br>written thought</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>clamp(38–51px)</span>
						<span class="spec-item"><span>leading</span>1.08</span>
						<span class="spec-item"><span>tracking</span>−0.02em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">h3 · Source Serif 4 600</span>
					<p class="t-h3">A sentence holds<br>its own gravity</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>clamp(27–35px)</span>
						<span class="spec-item"><span>leading</span>1.20</span>
						<span class="spec-item"><span>tracking</span>−0.01em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">h4 · Source Serif 4 600</span>
					<p class="t-h4">Contrast builds clarity between structure and flow</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>clamp(19–24px)</span>
						<span class="spec-item"><span>leading</span>1.30</span>
						<span class="spec-item"><span>tracking</span>0em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">body lead · Source Serif 4 400</span>
					<p class="t-lead">
						Reading is a performance of the eye across space. The rhythm of a
						paragraph lives in its leading—too tight and the eye loses its path;
						too loose and the reader floats untethered between lines.
					</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>clamp(17–19px)</span>
						<span class="spec-item"><span>leading</span>1.75</span>
						<span class="spec-item"><span>tracking</span>0.01em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">body · Source Serif 4 400</span>
					<p class="t-body">
						The paragraph is the unit of thought. Each line break is a breath,
						each sentence a step. Good spacing lets the meaning settle before
						the next idea arrives, quietly, without interruption.
					</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>clamp(16–17px)</span>
						<span class="spec-item"><span>leading</span>1.70</span>
						<span class="spec-item"><span>tracking</span>0.005em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">small · Source Serif 4 400</span>
					<p class="t-small a-muted">
						Footnotes carry the weight of evidence. At smaller sizes, leading
						must increase proportionally—the eye needs more air between lines.
					</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>13.4px</span>
						<span class="spec-item"><span>leading</span>1.65</span>
						<span class="spec-item"><span>tracking</span>0.01em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">caption · Source Serif 4 300 Italic</span>
					<p class="t-caption a-muted">
						Fig. 1 — Visual hierarchy emerges from contrast in weight, size, and
						spatial rhythm rather than from decoration alone.
					</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>12.3px</span>
						<span class="spec-item"><span>leading</span>1.60</span>
						<span class="spec-item"><span>tracking</span>0.02em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">mono · Victor Mono Italic 400</span>
					<p class="t-mono a-accent">
						const rhythm = lineHeight * fontSize;<br>// spacing makes prose
						readable
					</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>14px</span>
						<span class="spec-item"><span>leading</span>1.60</span>
						<span class="spec-item"><span>tracking</span>0.03em</span>
					</div>
				</div>

				<div class="block">
					<span class="meta">mono sm · Victor Mono Italic 400</span>
					<p class="t-mono-sm a-faint">
						font-size: 12px; line-height: 1.55; letter-spacing: 0.04em;
					</p>
					<div class="spec">
						<span class="spec-item"><span>size</span>12.3px</span>
						<span class="spec-item"><span>leading</span>1.55</span>
						<span class="spec-item"><span>tracking</span>0.04em</span>
					</div>
				</div>
			</section>

			<section class="ds-section" aria-labelledby="light-components">
				<h2 id="light-components" class="ds-section-title">Components</h2>

				<div class="block">
					<span class="meta">Surface cards</span>
					<div class="ds-surfaces">
						<div class="ds-surface ds-surface--alt">
							<div class="ds-card">
								<p class="t-h4">bgCard on bgAlt</p>
								<p class="t-body a-muted">
									Card surface uses bgCard over an alternate page background.
								</p>
							</div>
						</div>
						<div class="ds-surface ds-surface--warm">
							<div class="ds-card">
								<p class="t-h4">bgCard on bgWarm</p>
								<p class="t-body a-muted">
									Warm background for editorial or featured content blocks.
								</p>
							</div>
						</div>
					</div>
				</div>

				<div class="block">
					<span class="meta">Alt cards</span>
					<div class="ds-alt-cards">
						{altCards.map((card) => (
								<div
									class="ds-alt-card"
									style={`background:var(--color-${card.token})`}
								>
									<p class="t-h4">{card.label}</p>
									<p class="t-small a-muted">{card.token}</p>
								</div>
							))}
					</div>
				</div>

				<div class="block">
					<span class="meta">Buttons</span>
					<div class="ds-btns">
						<button type="button" class="ds-btn ds-btn--filled">
							Primary action
						</button>
						<button type="button" class="ds-btn ds-btn--outline">
							Secondary action
						</button>
						<button type="button" class="ds-btn ds-btn--filled" disabled>
							Disabled
						</button>
					</div>
				</div>

				<div class="block">
					<span class="meta">Semantic alerts</span>
					<div class="ds-alerts">
						{alerts.map((alert) => (
								<div
									class="ds-alert"
									style={`background:var(--color-${alert.bg});color:var(--color-${alert.fg});border-color:var(--color-${alert.bd})`}
								>
									<strong>{alert.kind}</strong> — semantic token trio for
									foreground, background, and border.
								</div>
							))}
					</div>
				</div>
			</section>
		</section>

		<div class="rule"></div>
	</div>
</Layout>

<style>
@import "../styles/design-system.css";
</style>

<style is:global set:html={colDarkCSS}></style>
