					<span class="spec-item"><span>tracking</span>0.04em</span>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
.type-specimen {
	--primary: #111317;
	--secondary: #f7f6f1;
	--muted: #5a5d65;
	--faint: #9498a2;
	--darkaccent: #8badb8;
	--darkhighlight: #1c2e33;
	--lightaccent: #5f1b36;
	--lighthighlight: #f0e0e6;
	--font-heading: var(--font-syne);
	--font-body: var(--font-source-serif-4);
	--font-mono: var(--font-victor-mono);
	--sp-3: 0.75rem;
	--sp-4: 1rem;
	--sp-8: 2rem;
	--sp-10: 2.5rem;
	--sp-12: 3rem;

	display: flex;
	flex-direction: column;
	min-height: 100vh;
	background: var(--secondary);
	color: var(--primary);
	font-family: var(--font-body);
	text-rendering: optimizeLegibility;
	-webkit-font-smoothing: antialiased;
}

.type-specimen,
.type-specimen * {
	box-sizing: border-box;
}

.col {
	display: flex;
	flex: none;
	flex-direction: column;
	padding: var(--sp-12) var(--sp-10);
}

.col--dark {
	background: var(--primary);
	color: var(--secondary);
}

.rule {
	width: 100%;
	height: 1px;
	flex-shrink: 0;
	background: oklch(from #5a5d65 l c h / 22%);
}

.col-header {
	margin-bottom: 0;
	padding-bottom: var(--sp-8);
	border-bottom: 1px solid oklch(from #9498a2 l c h / 25%);
}

.col-header-label {
	display: block;
	margin-bottom: var(--sp-3);
	color: var(--faint);
	font-family: var(--font-mono);
	font-size: 10px;
	font-style: italic;
	letter-spacing: 0.14em;
	text-transform: uppercase;
}

.swatches {
	display: flex;
	flex-wrap: wrap;
	gap: 5px;
	margin-top: var(--sp-3);
}

.swatch {
	width: 20px;
	height: 20px;
	border: 1px solid oklch(from #111 l c h / 10%);
	border-radius: 4px;
}

.block {
	padding: var(--sp-8) 0;
	border-bottom: 1px solid oklch(from #9498a2 l c h / 18%);
}

.block:last-child {
	border-bottom: none;
}

.meta {
	display: block;
	margin-bottom: var(--sp-3);
	color: var(--faint);
	font-family: var(--font-mono);
	font-size: 10px;
	font-style: italic;
	letter-spacing: 0.12em;
	text-transform: uppercase;
}

.spec {
	display: flex;
	flex-wrap: wrap;
	gap: var(--sp-4);
	margin-top: var(--sp-3);
}

.spec-item {
	color: var(--faint);
	font-family: var(--font-mono);
	font-size: 10px;
	font-style: italic;
	letter-spacing: 0.1em;
	white-space: nowrap;
}

.spec-item span {
	margin-right: 2px;
	opacity: 0.55;
}

.t-h1 {
	font-family: var(--font-heading);
	font-size: clamp(3.5rem, 5.5vw, 5rem);
	font-weight: 600;
	line-height: 1;
	letter-spacing: -0.03em;
}

.t-h2 {
	font-family: var(--font-heading);
	font-size: clamp(2.4rem, 3.8vw, 3.2rem);
	font-weight: 700;
	line-height: 1.08;
	letter-spacing: -0.02em;
}

.t-h3 {
	font-family: var(--font-body);
	font-size: clamp(1.7rem, 2.5vw, 2.2rem);
	font-weight: 600;
	line-height: 1.2;
	letter-spacing: -0.01em;
}

.t-h4 {
	font-family: var(--font-body);
	font-size: clamp(1.2rem, 1.6vw, 1.5rem);
	font-weight: 600;
	line-height: 1.3;
	letter-spacing: 0;
}

.t-lead {
	font-family: var(--font-body);
	font-size: clamp(1.05rem, 1.3vw, 1.2rem);
	font-weight: 400;
	line-height: 1.75;
	letter-spacing: 0.01em;
}

.t-body {
	font-family: var(--font-body);
	font-size: clamp(1rem, 1.1vw, 1.075rem);
	font-weight: 400;
	line-height: 1.7;
	letter-spacing: 0.005em;
}

.t-small {
	font-family: var(--font-body);
	font-size: 0.8375rem;
	font-weight: 400;
	line-height: 1.65;
	letter-spacing: 0.01em;
}

.t-caption {
	font-family: var(--font-body);
	font-size: 0.77rem;
	font-style: italic;
	font-weight: 300;
	line-height: 1.6;
	letter-spacing: 0.02em;
}

.t-mono {
	font-family: var(--font-mono);
	font-size: 0.875rem;
	font-style: italic;
	font-weight: 400;
	line-height: 1.6;
	letter-spacing: 0.03em;
}

.t-mono-sm {
	font-family: var(--font-mono);
	font-size: 0.77rem;
	font-style: italic;
	font-weight: 400;
	line-height: 1.55;
	letter-spacing: 0.04em;
}

.a-dark {
	color: var(--darkaccent);
}

.a-light {
	color: var(--lightaccent);
}

.a-dhl {
	color: var(--darkhighlight);
}

.col--dark .a-light {
	color: var(--lighthighlight);
}

.col--dark .a-muted {
	color: #9498a2;
}
</style>
