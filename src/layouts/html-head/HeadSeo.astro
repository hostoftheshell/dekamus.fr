---
import { siteConfig } from "@config/content/site";
import Seo from "@jdevalk/astro-seo-graph/Seo.astro";
import type { buildSchemaGraph } from "@utils/schema";

interface Props {
	title: string;
	description: string;
	ogImage: string;
	noindex: boolean;
	graph: ReturnType<typeof buildSchemaGraph>;
}

const { title, description, ogImage, noindex, graph } = Astro.props;
---

<Seo
	title={title}
	description={description}
	siteName={siteConfig.name}
	locale={siteConfig.locale}
	ogType="website"
	ogImage={ogImage}
	ogImageAlt={title}
	ogImageWidth={siteConfig.og.width}
	ogImageHeight={siteConfig.og.height}
	noindex={noindex}
	graph={graph}
	extraLinks={[
		{ rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
		{ rel: "icon", href: "/favicon.ico" },
		{ rel: "sitemap", href: "/sitemap-index.xml" },
	]}
/>
