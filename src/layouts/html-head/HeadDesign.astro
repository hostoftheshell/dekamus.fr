---
import { Font } from "astro:assets";
import ColorStyles from "@components/utils/ColorsCSSVars.astro";
import { borderRadiusToCSSVars } from "@config/design/borderRadius";
import { ColorData } from "@config/design/colors";
import { spacingToCSSVars } from "@config/design/spacing";

const defaultMode = ColorData.colors.mode;

const designTokensCss = `:root {
${spacingToCSSVars()}
${borderRadiusToCSSVars()}
}`;
---

<script is:inline define:vars={{ defaultMode }}>
(() => {
	const KEY = "theme:mode";
	let mode = localStorage.getItem(KEY);
	if (mode !== "auto" && mode !== "light" && mode !== "dark") {
		mode = defaultMode;
	}
	if (mode === "light" || mode === "dark") {
		document.documentElement.style.colorScheme = mode;
	}
})();
</script>
<ColorStyles />
<style is:global>
@import "@styles/index.css";
</style>
<style is:global set:html={designTokensCss}></style>
<Font cssVariable="--font-syne" preload />
<Font cssVariable="--font-source-serif-4" preload />
<Font cssVariable="--font-victor-mono" />
