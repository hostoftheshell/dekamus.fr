		<main class="h-100dvh flex flex-col">
			<slot />
		</main>
		<!-- <footer class="w-full border-t border-faint mt-auto">
			<div class="container-wide py-6">
				<FooterNav {currentPath} />
				<LegalNav {currentPath} />
			</div>
		</footer> -->
		<script>
		import { initThemedEmbeds } from "@utils/media/themedEmbeds";

		initThemedEmbeds();
		</script>
	</body>
</html>
