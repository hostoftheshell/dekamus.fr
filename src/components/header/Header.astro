---
import Logo from "@components/logo/Logo.astro";
import ThemeToggle from "@components/utils/ThemeToggle.astro";
---

<header class="site-header is-at-top fixed inset-x-0 top-0 z-50 w-full">
	<div class="site-header-inner p-4 transition-transform duration-600 ease-out">
		<span class="header-mobile-bg md:hidden" aria-hidden="true"></span>
		<div
			class="header-pill-host container-header relative flex w-full flex-wrap items-center justify-between gap-[.5vw] px-[.5vw] py-[.5vw] md:w-fit"
		>
			<div class="nav-mobile-logo-chrome inline-flex md:contents">
				<Logo variant="stacked" class="inline-flex h-12 w-auto md:hidden" />
			</div>
			<Logo
				variant="stacked"
				class="hidden h-12 w-auto md:inline-flex"
				pillTarget
			/>
			<slot />
			<div class="hidden md:contents">
				<ThemeToggle />
			</div>
			<span class="nav-highlight hidden md:block" aria-hidden="true"></span>
		</div>
	</div>
</header>

<script is:inline>
(() => {
	const header = document.currentScript?.previousElementSibling;
	if (!(header instanceof HTMLElement) || !header.classList.contains("site-header")) {
		return;
	}
	document.documentElement.style.setProperty(
		"--site-header-height",
		`${header.offsetHeight}px`,
	);
})();
</script>

<script>
(() => {
	const DESKTOP_MQ = window.matchMedia("(min-width: 768px)");
	const REDUCED_MOTION_MQ = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	);
	const BG_THRESHOLD = 50;
	const HIDE_THRESHOLD = 350;

	type CleanupFn = () => void;
	const cleanups: CleanupFn[] = [];

	function addCleanup(fn: CleanupFn) {
		cleanups.push(fn);
	}

	function runCleanups() {
		while (cleanups.length > 0) {
			cleanups.pop()?.();
		}
	}

	// --- Pill ---

	function isHighlightHidden(highlight: HTMLElement): boolean {
		return highlight.style.opacity === "" || highlight.style.opacity === "0";
	}

	function moveHighlight(
		target: HTMLElement,
		opts?: { direction?: "ltr" | "rtl" },
	) {
		const host = target.closest(".header-pill-host");
		const highlight = host?.querySelector<HTMLElement>(".nav-highlight");
		if (!host || !highlight) return;

		const hostRect = host.getBoundingClientRect();
		const rect = target.getBoundingClientRect();
		const x = rect.left - hostRect.left;
		const y = rect.top - hostRect.top;
		const w = rect.width;
		const h = rect.height;

		const useDirection =
			opts?.direction &&
			isHighlightHidden(highlight) &&
			!REDUCED_MOTION_MQ.matches;

		if (useDirection) {
			highlight.style.transition = "none";
			highlight.style.height = `${h}px`;
			highlight.style.opacity = "1";
			highlight.style.width = "0px";
			highlight.style.transform =
				opts.direction === "ltr"
					? `translate(${x}px, ${y}px)`
					: `translate(${x + w}px, ${y}px)`;
			highlight.offsetHeight;
			highlight.style.transition = "";
			highlight.style.width = `${w}px`;
			highlight.style.transform = `translate(${x}px, ${y}px)`;
			return;
		}

		highlight.style.width = `${w}px`;
		highlight.style.height = `${h}px`;
		highlight.style.transform = `translate(${x}px, ${y}px)`;
		highlight.style.opacity = "1";
	}

	function hideHighlight(host: Element) {
		const highlight = host.querySelector<HTMLElement>(".nav-highlight");
		if (highlight) highlight.style.opacity = "0";
	}

	function getPillTargets(host: Element): HTMLElement[] {
		return [
			...host.querySelectorAll<HTMLElement>(".nav-pill-target"),
			...host.querySelectorAll<HTMLElement>(".nav-desktop .nav-item a"),
		];
	}

	function getActiveTarget(host: Element): HTMLElement | null {
		const highlight = host.querySelector<HTMLElement>(".nav-highlight");
		if (!highlight || isHighlightHidden(highlight)) return null;

		for (const target of getPillTargets(host)) {
			if (target.matches(":hover, :focus")) return target;
		}
		return null;
	}

	function initPill() {
		if (!DESKTOP_MQ.matches) return;

		const host = document.querySelector<HTMLElement>(".header-pill-host");
		if (!host) return;

		const onMouseLeave = () => hideHighlight(host);
		host.addEventListener("mouseleave", onMouseLeave);

		const targetCleanups: CleanupFn[] = [];
		for (const target of getPillTargets(host)) {
			const onMouseEnter = target.hasAttribute("data-pill-directional")
				? (e: MouseEvent) => {
						const rect = target.getBoundingClientRect();
						const fromLeft = e.clientX < rect.left + rect.width / 2;
						moveHighlight(target, {
							direction: fromLeft ? "ltr" : "rtl",
						});
					}
				: () => moveHighlight(target);
			const onFocus = () => moveHighlight(target);

			target.addEventListener("mouseenter", onMouseEnter);
			target.addEventListener("focus", onFocus);
			targetCleanups.push(() => {
				target.removeEventListener("mouseenter", onMouseEnter);
				target.removeEventListener("focus", onFocus);
			});
		}

		const observer = new ResizeObserver(() => {
			const active = getActiveTarget(host);
			if (active) moveHighlight(active);
		});
		observer.observe(host);

		addCleanup(() => {
			host.removeEventListener("mouseleave", onMouseLeave);
			for (const fn of targetCleanups) fn();
			observer.disconnect();
		});
	}

	// --- Scroll ---

	function isMobileNavOpen(header: HTMLElement): boolean {
		return (
			header.classList.contains("is-nav-open") ||
			document.querySelector(".nav-mobile.is-open") !== null
		);
	}

	function syncHeaderHeight(header: HTMLElement) {
		document.documentElement.style.setProperty(
			"--site-header-height",
			`${header.offsetHeight}px`,
		);
	}

	function initScroll(header: HTMLElement) {
		let lastScrollY = window.scrollY;
		let ticking = false;

		function applyScrollState() {
			const scrollY = window.scrollY;
			const scrollDelta = scrollY - lastScrollY;
			const scrollingDown = scrollDelta > 0;
			const scrollingUp = scrollDelta < 0;
			const atTop = scrollY <= BG_THRESHOLD;
			const navOpen = isMobileNavOpen(header);

			header.classList.toggle("is-at-top", atTop);
			header.classList.toggle("is-scrolled", scrollY > BG_THRESHOLD);

			if (atTop || scrollingUp) {
				header.classList.remove("is-header-hidden");
			} else if (scrollingDown && scrollY > HIDE_THRESHOLD && !navOpen) {
				header.classList.add("is-header-hidden");
			}

			lastScrollY = scrollY;
			ticking = false;
		}

		function onScroll() {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(applyScrollState);
			}
		}

		function onResize() {
			syncHeaderHeight(header);
		}

		syncHeaderHeight(header);
		applyScrollState();
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onResize);
		addCleanup(() => {
			window.removeEventListener("scroll", onScroll);
			window.removeEventListener("resize", onResize);
		});
	}

	function init() {
		runCleanups();

		const header = document.querySelector<HTMLElement>(".site-header");
		const pillHost = document.querySelector<HTMLElement>(".header-pill-host");
		if (!header || !pillHost) return;

		initScroll(header);
		initPill();
	}

	init();
	DESKTOP_MQ.addEventListener("change", init);
})();
</script>

<style>
:root {
	/* p-4 * 2 + max(logo chrome, 3rem trigger) + pill vertical padding */
	--site-header-height: calc(var(--sp-4) * 2 + 3rem + 1vw);
}

.site-header {
	transition:
		background-color 200ms ease,
		backdrop-filter 200ms ease;
}

:global(body) {
	padding-top: var(--site-header-height, 0px);
}

.header-mobile-bg {
	position: absolute;
	inset-inline: 0;
	top: 0;
	height: 100%;
	pointer-events: none;
	transition:
		background-color 200ms ease,
		backdrop-filter 200ms ease;
}

.nav-mobile-logo-chrome {
	align-items: center;
	justify-content: center;
	padding: var(--sp-2);
	border-radius: var(--radius-md);
	background-color: oklch(from var(--color-bgAlt) l c h / 1);
	transition: background-color 200ms ease;
}

.header-pill-host {
	border-radius: var(--radius-md);
	background-color: transparent;
	backdrop-filter: none;
	transition:
		background-color 200ms ease,
		backdrop-filter 200ms ease;
}

@media (min-width: 768px) {
	.site-header.is-scrolled .header-pill-host {
		background-color: oklch(from var(--color-bgAlt) l c h / 0.8);
		backdrop-filter: blur(10px);
	}
}

@media (max-width: 767px) {
	.site-header.is-scrolled .header-pill-host {
		background-color: transparent;
		backdrop-filter: none;
	}

	.site-header.is-scrolled .header-mobile-bg,
	.site-header:has(.nav-mobile.is-open) .header-mobile-bg {
		background-color: oklch(from var(--color-bgAlt) l c h / 0.8);
		backdrop-filter: blur(10px);
	}

	.site-header:has(.nav-mobile.is-open) {
		background-color: oklch(from var(--color-bgAlt) l c h / 0.8);
	}

	.site-header:has(.nav-mobile.is-open) .header-mobile-bg {
		background-color: transparent;
		backdrop-filter: none;
	}

	.site-header:has(.nav-mobile.is-open) .nav-mobile-logo-chrome,
	.site-header:has(.nav-mobile.is-open) :global(.nav-mobile-chrome) {
		background-color: transparent;
	}
}

@media (prefers-reduced-motion: reduce) {
	.site-header-inner {
		transition: none;
	}
}

.site-header.is-header-hidden {
	pointer-events: none;
}

.site-header.is-header-hidden .site-header-inner {
	transform: translateY(-100%);
}

:global(.nav-highlight) {
	position: absolute;
	top: 0;
	left: 0;
	height: 0;
	width: 0;
	border-radius: var(--radius-sm);
	background: oklch(from var(--color-highlight) l c h / 0.8);
	pointer-events: none;
	opacity: 0;
}

@media (prefers-reduced-motion: no-preference) {
	:global(.nav-highlight) {
		transition:
			transform 220ms cubic-bezier(0.4, 0, 0.2, 1),
			width 220ms cubic-bezier(0.4, 0, 0.2, 1),
			height 220ms cubic-bezier(0.4, 0, 0.2, 1),
			opacity 150ms ease;
	}
}
</style>
