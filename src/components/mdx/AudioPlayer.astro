---
// SYNC WITH keystatic.config.ts → mdxComponentBlocks.AudioPlayer
import {
	audioEmbedHeight,
	extractAudioEmbedUrl,
} from "@utils/media/normalizeEmbed";

interface Props {
	platform:
		| "spotify"
		| "deezer"
		| "soundcloud"
		| "radio-france"
		| "arte"
		| "hosted";
	embedUrl?: string;
	src?: string;
	title?: string;
	vttSrc?: string;
	transcriptUrl?: string;
}

const {
	platform,
	embedUrl = "",
	src = "",
	title = "Audio",
	vttSrc,
	transcriptUrl,
} = Astro.props;

const isEmbed = platform !== "hosted";
const embed =
	isEmbed && embedUrl
		? extractAudioEmbedUrl(
				platform as
					| "spotify"
					| "deezer"
					| "soundcloud"
					| "radio-france"
					| "arte",
				embedUrl,
			)
		: null;
const iframeSrc = embed?.valid ? embed.value : "";
const iframeHeight = isEmbed ? audioEmbedHeight(platform) : 0;
---

<figure class="audio-player stack-sm">
	{isEmbed && iframeSrc ? (
		<div
			class="w-full overflow-hidden rounded"
			style={`height: ${iframeHeight}px`}
		>
			<iframe
				class="h-full w-full border-0"
				src={iframeSrc}
				title={title}
				width="100%"
				height={iframeHeight}
				loading="eager"
				referrerpolicy="strict-origin-when-cross-origin"
				allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
				allowfullscreen
			/>
		</div>
	) : !isEmbed && src && vttSrc ? (
		<>
			<audio class="w-full" controls preload="metadata" src={src}>
				<track
					kind="captions"
					src={vttSrc}
					srclang="fr"
					label="Français"
					default
				/>
			</audio>
			<div
				class="audio-captions t-body min-h-[1.5em] text-muted"
				aria-live="polite"
			/>
		</>
	) : !isEmbed && src ? (
		// biome-ignore lint/a11y/useMediaCaption: vttSrc and transcriptUrl are optional editorial fields
		<audio class="w-full" controls preload="metadata" src={src} />
	) : (
		<p class="t-body text-muted">Source audio invalide.</p>
	)}

	{transcriptUrl && (
		<figcaption class="t-body text-muted">
			<a href={transcriptUrl} target="_blank" rel="noopener noreferrer">
				Transcription textuelle
			</a>
		</figcaption>
	)}
</figure>

<script>
document.querySelectorAll("figure.audio-player audio").forEach((element) => {
	if (!(element instanceof HTMLAudioElement)) return;
	const audio = element;
	if (!audio.querySelector("track")) return;
	const captions = audio.closest("figure")?.querySelector(".audio-captions");
	if (!captions) return;
	const track = audio.textTracks[0];
	if (!track) return;
	track.mode = "showing";
	track.addEventListener("cuechange", () => {
		const cue = track.activeCues?.[0];
		captions.textContent = cue instanceof VTTCue ? cue.text : "";
	});
});
</script>


