---
// SYNC WITH keystatic.config.ts → mdxComponentBlocks.AudioPlayer
import {
	audioEmbedHeight,
	extractAudioEmbedUrl,
} from "@utils/media/normalizeEmbed";

interface Props {
	platform:
		| "spotify"
		| "deezer"
		| "soundcloud"
		| "radio-france"
		| "arte"
		| "hosted";
	embedUrl?: string;
	src?: string;
	title?: string;
}

const { platform, embedUrl = "", src = "", title = "Audio" } = Astro.props;

const isEmbed = platform !== "hosted";
const embed =
	isEmbed && embedUrl
		? extractAudioEmbedUrl(
				platform as
					| "spotify"
					| "deezer"
					| "soundcloud"
					| "radio-france"
					| "arte",
				embedUrl,
			)
		: null;
const iframeSrc = embed?.valid ? embed.value : "";
const iframeHeight = isEmbed ? audioEmbedHeight(platform) : 0;
---

<figure class="stack-sm">
	{isEmbed && iframeSrc ? (
		<div
			class="w-full overflow-hidden rounded"
			style={`height: ${iframeHeight}px`}
		>
			<iframe
				class="h-full w-full border-0"
				src={iframeSrc}
				title={title}
				width="100%"
				height={iframeHeight}
				loading="eager"
				referrerpolicy="strict-origin-when-cross-origin"
				allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
				allowfullscreen
			/>
		</div>
	) : !isEmbed && src ? (
		<audio class="w-full" controls preload="metadata" src={src} />
	) : (
		<p class="t-body text-muted">Source audio invalide.</p>
	)}
</figure>
