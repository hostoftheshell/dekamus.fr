---
// SYNC WITH keystatic.config.ts → mdxComponentBlocks.AudioPlayer
import {
	audioEmbedHeight,
	extractAudioEmbedUrl,
} from "@utils/media/normalizeEmbed";
import { resolveAudioSource } from "@utils/media/resolveKeystaticSource";
import HostedMediaCaption from "./HostedMediaCaption.astro";
import HostedMediaControls from "./HostedMediaControls.astro";

interface Props {
	platform?:
		| "spotify"
		| "deezer"
		| "soundcloud"
		| "radio-france"
		| "arte"
		| "hosted";
	embedUrl?: string;
	src?: string;
	source?: {
		discriminant:
			| "spotify"
			| "deezer"
			| "soundcloud"
			| "radio-france"
			| "arte"
			| "hosted";
		value: {
			embedUrl?: string;
			src?: string;
			vttSrc?: string;
			title?: string;
			date?: string;
			description?: string;
		};
	};
	accessibleTitle?: string;
	/** @deprecated use accessibleTitle */
	title?: string;
	vttSrc?: string;
	transcriptUrl?: string;
}

const {
	accessibleTitle: accessibleTitleProp,
	title: legacyTitle,
	transcriptUrl,
	...rest
} = Astro.props;
const accessibleTitle = accessibleTitleProp ?? legacyTitle ?? "Audio";
const { platform, embedUrl, src, vttSrc, metadata } = resolveAudioSource(rest);

const isEmbed = platform !== "hosted";
const embedPlatform = isEmbed
	? (platform as "spotify" | "deezer" | "soundcloud" | "radio-france" | "arte")
	: null;
const embed =
	isEmbed && embedUrl && embedPlatform ? extractAudioEmbedUrl(embedUrl) : null;
const iframeSrc = embed?.valid ? embed.value : "";
const iframeHeight = embedPlatform ? audioEmbedHeight(embedPlatform) : 0;
---

<figure class="audio-player stack-sm">
	{isEmbed && iframeSrc && embedPlatform ? (
		<div
			class="media-embed-frame media-embed-frame--audio"
			style={`height: ${iframeHeight}px`}
		>
			<iframe
				class="h-full w-full border-0"
				src={iframeSrc}
				title={accessibleTitle}
				width="100%"
				height={iframeHeight}
				loading="eager"
				referrerpolicy="strict-origin-when-cross-origin"
				allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
				allowfullscreen
			/>
		</div>
	) : !isEmbed && src ? (
		<>
			{/* biome-ignore lint/a11y/useMediaCaption: vttSrc and transcriptUrl are optional editorial fields */}
			<audio preload="metadata" src={src} hidden>
				{vttSrc ? (
					<track
						kind="captions"
						src={vttSrc}
						srclang="fr"
						label="Français"
						default
					/>
				) : null}
			</audio>
			<HostedMediaControls />
			{vttSrc ? (
				<div
					class="audio-captions t-body min-h-[1.5em] text-muted"
					aria-live="polite"
				/>
			) : null}
		</>
	) : (
		<p class="t-body text-muted">Source audio invalide.</p>
	)}

	{!isEmbed && metadata && <HostedMediaCaption metadata={metadata} />}

	{transcriptUrl && (
		<figcaption class="t-body text-muted">
			<a href={transcriptUrl} target="_blank" rel="noopener noreferrer">
				Transcription textuelle
			</a>
		</figcaption>
	)}
</figure>

<script>
import { initAudioPlayers } from "./hostedMediaPlayer";

initAudioPlayers();
</script>