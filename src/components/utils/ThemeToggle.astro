---
import { ColorData } from "@config/design/colors";

const defaultMode = ColorData.colors.mode;
---

<button
	type="button"
	class="theme-toggle nav-pill-target transition-colors"
	aria-label="Toggle theme"
	data-default-mode={defaultMode}
	data-pill-directional
>
	<span class="theme-toggle__icons" aria-hidden="true">
		<span class="icon-sun i-lucide-sun-medium size-5" aria-hidden="true" />
		<span class="icon-moon i-lucide-moon size-5" aria-hidden="true" />
		<span class="icon-auto i-lucide-eclipse size-5" aria-hidden="true" />
	</span>
</button>

<script>
import { getSiteColorScheme } from "@utils/theme/resolveSiteColorScheme";

(() => {
	type ThemeMode = "auto" | "light" | "dark";

	const STORAGE_KEY = "theme:mode";

	function dispatchThemeChange(mode: ThemeMode) {
		document.dispatchEvent(
			new CustomEvent("dekamus:theme-change", {
				detail: { mode, scheme: getSiteColorScheme() },
			}),
		);
	}

	function applyMode(mode: ThemeMode) {
		const root = document.documentElement;
		if (mode === "auto") {
			root.style.removeProperty("color-scheme");
		} else {
			root.style.colorScheme = mode;
		}
		root.dataset.theme = mode;
		dispatchThemeChange(mode);
	}

	function readStoredMode(): ThemeMode | null {
		try {
			const value = localStorage.getItem(STORAGE_KEY);
			if (value === "auto" || value === "light" || value === "dark") {
				return value;
			}
			return null;
		} catch {
			return null;
		}
	}

	function storeMode(mode: ThemeMode) {
		try {
			localStorage.setItem(STORAGE_KEY, mode);
		} catch {
			// ignore
		}
	}

	function modeLabel(mode: ThemeMode) {
		if (mode === "auto") return "Auto";
		if (mode === "light") return "Light";
		return "Dark";
	}

	function nextMode(mode: ThemeMode): ThemeMode {
		if (mode === "auto") return "light";
		if (mode === "light") return "dark";
		return "auto";
	}

	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>(".theme-toggle"),
	);
	if (!buttons.length) return;

	const defaultModeAttr = buttons[0]?.getAttribute("data-default-mode");
	const defaultMode: ThemeMode =
		defaultModeAttr === "light" ||
		defaultModeAttr === "dark" ||
		defaultModeAttr === "auto"
			? defaultModeAttr
			: "auto";

	let currentMode: ThemeMode = readStoredMode() ?? defaultMode;
	applyMode(currentMode);

	function render() {
		const label = modeLabel(currentMode);

		for (const btn of buttons) {
			btn.setAttribute(
				"aria-pressed",
				currentMode === "dark" ? "true" : "false",
			);
			btn.setAttribute("data-mode", currentMode);
			btn.setAttribute("title", `Theme: ${label} (click to change)`);
		}
	}

	render();

	for (const btn of buttons) {
		btn.addEventListener("click", () => {
			currentMode = nextMode(currentMode);
			storeMode(currentMode);
			applyMode(currentMode);
			render();
		});
	}

	const media = window.matchMedia("(prefers-color-scheme: dark)");
	media.addEventListener("change", () => {
		if (currentMode === "auto") {
			render();
			dispatchThemeChange(currentMode);
		}
	});
})();
</script>

<style>
.theme-toggle {
	position: relative;
	z-index: 1;
	cursor: pointer;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: var(--sp-2);
	background: transparent;
	border: 1px solid transparent;
	border-radius: var(--radius-sm);
	color: var(--color-primary);
	font: inherit;
	line-height: 1;
}

.theme-toggle:hover {
	color: var(--color-accent);
}

.theme-toggle:focus-visible {
	outline: 1px solid var(--color-accent);
	outline-offset: 2px;
}

.theme-toggle__icons {
	width: 1.25rem;
	height: 1.25rem;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	position: relative;
}

.theme-toggle__icons > span {
	display: none;
	position: absolute;
}

.theme-toggle[data-mode="light"] .icon-sun {
	display: block;
}

.theme-toggle[data-mode="dark"] .icon-moon {
	display: block;
}

.theme-toggle[data-mode="auto"] .icon-auto {
	display: block;
}
</style>
