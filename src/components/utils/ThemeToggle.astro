---
import { ColorData } from "@config/colors";

const defaultMode = ColorData.colors.mode;
---

<button
	type="button"
	class="theme-toggle"
	aria-label="Toggle theme"
	data-default-mode={defaultMode}
>
	<span class="theme-toggle__icons" aria-hidden="true">
		<svg
			class="icon-sun"
			width="20"
			height="20"
			viewBox="0 0 512 512"
			aria-hidden="true"
		>
			<path
				fill="currentColor"
				d="M256 118a22 22 0 0 1-22-22V48a22 22 0 0 1 44 0v48a22 22 0 0 1-22 22Zm-96 38a22 22 0 0 1-31-31l-34-34a22 22 0 0 1 31-31l34 34a22 22 0 0 1 0 31Zm192 0a22 22 0 0 1 0-31l34-34a22 22 0 1 1 31 31l-34 34a22 22 0 0 1-31 0ZM48 256a22 22 0 0 1 22-22h48a22 22 0 0 1 0 44H70a22 22 0 0 1-22-22Zm368 0a22 22 0 0 1 22-22h48a22 22 0 0 1 0 44h-48a22 22 0 0 1-22-22ZM118 352a22 22 0 0 1 31 0l34 34a22 22 0 1 1-31 31l-34-34a22 22 0 0 1 0-31Zm276 0a22 22 0 0 1 0 31l-34 34a22 22 0 1 1-31-31l34-34a22 22 0 0 1 31 0ZM256 394a22 22 0 0 1 22 22v48a22 22 0 0 1-44 0v-48a22 22 0 0 1 22-22Z"
			></path>
			<circle cx="256" cy="256" r="96" fill="currentColor"></circle>
		</svg>
		<svg
			class="icon-moon"
			width="20"
			height="20"
			viewBox="0 0 512 512"
			aria-hidden="true"
		>
			<path
				fill="currentColor"
				d="M283.5 64c-8.8 0-17.4 1-25.7 2.9A192 192 0 0 0 96 256a192 192 0 0 0 192 192c41.5 0 79.9-13.2 111.3-35.5A160 160 0 0 1 283.5 64Z"
			></path>
		</svg>
		<svg
			class="icon-auto"
			width="20"
			height="20"
			viewBox="0 0 512 512"
			aria-hidden="true"
		>
			<path
				fill="currentColor"
				d="M256 48C141.1 48 48 141.1 48 256s93.1 208 208 208 208-93.1 208-208S370.9 48 256 48Zm0 368c-88.4 0-160-71.6-160-160S167.6 96 256 96s160 71.6 160 160-71.6 160-160 160Z"
			></path>
			<path
				fill="currentColor"
				d="M256 144v128l96 56-32 55-128-74V144h64Z"
			></path>
		</svg>
	</span>
</button>

<script>
(() => {
	type ThemeMode = "auto" | "light" | "dark";

	const STORAGE_KEY = "theme:mode";

	function applyMode(mode: ThemeMode) {
		const root = document.documentElement;
		if (mode === "auto") {
			root.style.removeProperty("color-scheme");
		} else {
			root.style.colorScheme = mode;
		}
		root.dataset.theme = mode;
	}

	function readStoredMode(): ThemeMode | null {
		try {
			const value = localStorage.getItem(STORAGE_KEY);
			if (value === "auto" || value === "light" || value === "dark") {
				return value;
			}
			return null;
		} catch {
			return null;
		}
	}

	function storeMode(mode: ThemeMode) {
		try {
			localStorage.setItem(STORAGE_KEY, mode);
		} catch {
			// ignore
		}
	}

	function modeLabel(mode: ThemeMode) {
		if (mode === "auto") return "Auto";
		if (mode === "light") return "Light";
		return "Dark";
	}

	function nextMode(mode: ThemeMode): ThemeMode {
		if (mode === "auto") return "light";
		if (mode === "light") return "dark";
		return "auto";
	}

	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>(".theme-toggle"),
	);
	if (!buttons.length) return;

	const defaultModeAttr = buttons[0]?.getAttribute("data-default-mode");
	const defaultMode: ThemeMode =
		defaultModeAttr === "light" ||
		defaultModeAttr === "dark" ||
		defaultModeAttr === "auto"
			? defaultModeAttr
			: "auto";

	let currentMode: ThemeMode = readStoredMode() ?? defaultMode;
	applyMode(currentMode);

	function render() {
		const label = modeLabel(currentMode);

		for (const btn of buttons) {
			btn.setAttribute(
				"aria-pressed",
				currentMode === "dark" ? "true" : "false",
			);
			btn.setAttribute("data-mode", currentMode);
			btn.setAttribute("title", `Theme: ${label} (click to change)`);
		}
	}

	render();

	for (const btn of buttons) {
		btn.addEventListener("click", () => {
			currentMode = nextMode(currentMode);
			storeMode(currentMode);
			applyMode(currentMode);
			render();
		});
	}

	const media = window.matchMedia("(prefers-color-scheme: dark)");
	media.addEventListener("change", () => {
		if (currentMode === "auto") render();
	});
})();
</script>

<style>
.theme-toggle {
	position: fixed;
	top: 1rem;
	right: 1rem;
	z-index: 100;
	cursor: pointer;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: 0.25rem;
	background: transparent;
	border: 0;
	color: var(--color-primary);
	font: inherit;
	line-height: 1;
	transition:
		color 0.2s ease,
		opacity 0.2s ease;
	opacity: 0.82;
}

.theme-toggle:hover {
	opacity: 1;
}

.theme-toggle:focus-visible {
	outline: 1px solid var(--color-accent);
	outline-offset: 2px;
}

.theme-toggle__icons {
	width: 1.25rem;
	height: 1.25rem;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	position: relative;
}

.theme-toggle__icons svg {
	display: none;
	position: absolute;
}

.theme-toggle[data-mode="light"] .icon-sun {
	display: block;
}

.theme-toggle[data-mode="dark"] .icon-moon {
	display: block;
}

.theme-toggle[data-mode="auto"] .icon-auto {
	display: block;
}
</style>
