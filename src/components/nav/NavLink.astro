---
import type { NavItem } from "@config/types";
import { isExternalHref, normalizeNavPath } from "@utils/nav-path";

type NavVariant = "header" | "header-mobile" | "footer" | "member";

interface Props {
	item: NavItem;
	variant: NavVariant;
	currentPath?: string;
	activeClass?: string;
	icon?: boolean;
}

const { item, variant, currentPath, activeClass, icon = false } = Astro.props;

const link = item.href;
const isExternal = isExternalHref(link);
const opensNewTab = item.newTab ?? isExternal;

const isActive =
	!isExternal &&
	currentPath !== undefined &&
	normalizeNavPath(currentPath) === normalizeNavPath(link);

const variantClasses: Record<NavVariant, string> = {
	header:
		"t-nav hover:text-accent transition-colors decoration-none",
	"header-mobile":
		"t-nav-mobile hover:text-accent transition-colors decoration-none",
	footer: "t-body text-sm hover:text-primary transition-colors decoration-none",
	member: "t-body hover:text-primary transition-colors decoration-none",
};

const defaultTextColors: Record<NavVariant, string> = {
	header: "text-primary",
	"header-mobile": "text-primary",
	footer: "text-muted",
	member: "text-muted",
};

const activeClassHasTextColor =
	isActive && activeClass !== undefined && /\btext-/.test(activeClass);

const classList = [
	variant === "header" || variant === "header-mobile"
		? "flex w-full items-center gap-1"
		: "inline-flex items-center gap-1",
	variantClasses[variant],
	!(isActive && activeClass && activeClassHasTextColor) &&
		defaultTextColors[variant],
	isActive && activeClass,
]
	.filter(Boolean)
	.join(" ");
---

<a
	href={link}
	class={classList}
	target={opensNewTab ? "_blank" : undefined}
	rel={opensNewTab ? "noopener noreferrer" : undefined}
	{...(isActive ? { "aria-current": "page" as const } : {})}
>
	{item.label}
	{icon && isExternal && (
			<span
				class="i-lucide-external-link size-3.5 shrink-0"
				aria-hidden="true"
			/>
		)}
	{opensNewTab && (
			<span class="visually-hidden"> (ouvre dans un nouvel onglet)</span>
		)}
</a>
