---
import { headerNavMobile } from "@config/content/navigation";
import NavLink from "./NavLink.astro";

interface Props {
	currentPath?: string;
}

const { currentPath } = Astro.props;
---

<ul class="nav-list grid w-full grid-cols-2 gap-4 md:hidden">
	{headerNavMobile.map((item) => (
		<li class="nav-item">
			<NavLink
				{item}
				variant="header"
				{currentPath}
				activeClass="font-semibold"
			/>
		</li>
	))}
</ul>
